<Window x:Class="GoldTicker.Wpf.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="370"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Border Margin="12"
          CornerRadius="12"
          Background="#F7191E26"
          BorderBrush="#2EFFFFFF"
          BorderThickness="1"
          Padding="22,20,22,18"
          MouseLeftButtonDown="Border_MouseLeftButtonDown">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="6" Direction="270" Opacity="0.55" Color="#000000" />
    </Border.Effect>
    <StackPanel>
      <Image x:Name="AppIcon"
             Width="56"
             Height="56"
             Margin="0,0,0,10"
             HorizontalAlignment="Center"
             RenderOptions.BitmapScalingMode="HighQuality" />
      <TextBlock x:Name="TitleBlock"
                 FontFamily="Segoe UI, Microsoft YaHei UI"
                 FontSize="15"
                 FontWeight="SemiBold"
                 Foreground="#F2FFFFFF"
                 HorizontalAlignment="Center"
                 TextAlignment="Center" />
      <TextBlock x:Name="BodyBlock"
                 Margin="0,10,0,16"
                 FontFamily="Segoe UI, Microsoft YaHei UI"
                 FontSize="12.5"
                 LineHeight="19"
                 Foreground="#B8FFFFFF"
                 TextWrapping="Wrap"
                 TextAlignment="Center" />
      <Button x:Name="OkButton"
              Width="96"
              Height="30"
              HorizontalAlignment="Center"
              Cursor="Hand"
              Click="OkButton_Click">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="BtnBorder"
                    CornerRadius="6"
                    Background="#2E58A6FF"
                    BorderBrush="#4D58A6FF"
                    BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BtnBorder" Property="Background" Value="#4758A6FF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
        <TextBlock x:Name="OkText"
                   FontFamily="Segoe UI, Microsoft YaHei UI"
                   FontSize="12.5"
                   Foreground="#FFFFFFFF" />
      </Button>
    </StackPanel>
  </Border>
</Window>
