<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GoldTicker.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GoldTicker">

  <Grid x:Name="Root" Background="#CC161B22" PointerPressed="Root_PointerPressed"
        PointerMoved="Root_PointerMoved" PointerReleased="Root_PointerReleased"
        RightTapped="Root_RightTapped">
    <Border x:Name="CardBorder" CornerRadius="14" BorderBrush="#33FFFFFF" BorderThickness="1"
            Background="#E612161C" Padding="14,12,14,10" Margin="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" Text="—" Foreground="#B3FFFFFF"
                   FontSize="12" FontFamily="Segoe UI Variable Text"/>

        <TextBlock x:Name="PriceText" Grid.Row="1" Text="--.--" Margin="0,6,0,0"
                   FontSize="28" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display"
                   Foreground="#FF5751"/>

        <TextBlock x:Name="DeltaText" Grid.Row="2" Text="—" Margin="0,2,0,0"
                   FontSize="13" FontFamily="Cascadia Mono, Consolas, Segoe UI"
                   Foreground="#FF5751"/>

        <TextBlock x:Name="DetailsText" Grid.Row="3" Text="" Margin="0,6,0,0"
                   FontSize="11" Foreground="#80FFFFFF"
                   FontFamily="Cascadia Mono, Consolas, Segoe UI"/>

        <Canvas x:Name="ChartCanvas" Grid.Row="4" Height="72" Margin="0,10,0,4"
                Background="Transparent"/>

        <TextBlock x:Name="FooterText" Grid.Row="5" Text="" FontSize="10"
                   Foreground="#66FFFFFF"/>
      </Grid>
    </Border>

    <Grid.ContextFlyout>
      <MenuFlyout x:Name="CardMenu">
        <MenuFlyoutItem x:Name="MenuRefresh" Text="刷新中..." Click="MenuRefresh_Click"/>
        <MenuFlyoutSeparator/>
        <ToggleMenuFlyoutItem x:Name="MenuChart" Text="显示走势图" Click="MenuChart_Click"/>
        <ToggleMenuFlyoutItem x:Name="MenuDetails" Text="显示 高/低/基准价" Click="MenuDetails_Click"/>
        <ToggleMenuFlyoutItem x:Name="MenuTop" Text="窗口置顶" Click="MenuTop_Click" IsChecked="True"/>
        <MenuFlyoutSeparator/>
        <MenuFlyoutSubItem x:Name="MenuSymbols" Text="行情标的"/>
        <MenuFlyoutSubItem x:Name="MenuBasis" Text="涨跌对比">
          <ToggleMenuFlyoutItem x:Name="BasisPrev" Text="较昨收价" Tag="prevClose" Click="Basis_Click"/>
          <ToggleMenuFlyoutItem x:Name="BasisOpen" Text="较今开盘" Tag="open" Click="Basis_Click"/>
        </MenuFlyoutSubItem>
        <MenuFlyoutSubItem x:Name="MenuColors" Text="涨跌配色">
          <ToggleMenuFlyoutItem x:Name="ColorCny" Text="红涨绿跌" Tag="cny" Click="Color_Click"/>
          <ToggleMenuFlyoutItem x:Name="ColorIntl" Text="绿涨红跌" Tag="intl" Click="Color_Click"/>
        </MenuFlyoutSubItem>
        <MenuFlyoutSubItem x:Name="MenuLang" Text="语言 (Language)">
          <ToggleMenuFlyoutItem Text="跟随系统" Tag="auto" Click="Lang_Click"/>
          <ToggleMenuFlyoutItem Text="简体中文" Tag="zh" Click="Lang_Click"/>
          <ToggleMenuFlyoutItem Text="English" Tag="en" Click="Lang_Click"/>
        </MenuFlyoutSubItem>
        <MenuFlyoutSubItem x:Name="MenuInterval" Text="刷新频率"/>
        <MenuFlyoutSubItem x:Name="MenuWidth" Text="卡片宽度"/>
        <MenuFlyoutSubItem x:Name="MenuOpacity" Text="卡片透明度"/>
        <MenuFlyoutSeparator/>
        <MenuFlyoutItem Text="打开配置文件所在目录" Click="OpenConfig_Click"/>
        <MenuFlyoutItem Text="清除走势缓存与历史" Click="ClearCache_Click"/>
        <MenuFlyoutItem Text="重置窗口位置" Click="ResetPos_Click"/>
        <MenuFlyoutSeparator/>
        <MenuFlyoutItem Text="关于 GoldTicker..." Click="About_Click"/>
        <MenuFlyoutItem Text="查看免责声明..." Click="Disclaimer_Click"/>
        <MenuFlyoutItem Text="访问 GitHub 仓库" Click="Github_Click"/>
        <MenuFlyoutItem Text="退出 GoldTicker" Click="Quit_Click"/>
      </MenuFlyout>
    </Grid.ContextFlyout>
  </Grid>
</Window>
